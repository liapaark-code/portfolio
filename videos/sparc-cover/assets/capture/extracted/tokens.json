    {
      "selector": "#insights",
      "type": "features",
      "x": 0,
      "y": 1561,
      "width": 1920,
      "height": 1366,
      "heading": "Turn Athlete Data Into Coaching Insights",
      "backgroundColor": "#0C0C0C",
      "callsToAction": [
        "Request a Demo"
      ],
      "text": "Turn Athlete Data Into Coaching Insights Real-time visibility into your roster's mental readiness — so you can coach with data, not guesswork. Team Mental Trends See focus, pressure, confidence, and motivation trends across your roster and identify performance dips AI-Powered Insights SPARC analyzes athlete journals and assessments to surface patterns and recommended training modules. Shared Athlete Journals Athletes can share reflections with coaches — creating better conversations about performance and mindset. Request a Demo",
      "layout": "grid",
      "assetUrls": [
        "https://r2.vidzflow.com/source/7aa9f273-f537-49b7-a957-164d213248bb.mov",
        "https://cdn.prod.website-files.com/69cab65125ea7dacf0680b53/69cab65125ea7dacf0680c75_04_Player_Profile_Screenshot-p-2000.webp",
        "https://cdn.prod.website-files.com/69cab65125ea7dacf0680b53/69cab65125ea7dacf0680bf6_Left%20Icon.svg",
        "https://cdn.prod.website-files.com/69cab65125ea7dacf0680b53/69cab65125ea7dacf0680cc8_arrow-new2.svg"
      ],
